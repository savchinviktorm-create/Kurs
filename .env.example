# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
TELEGRAM_BOT_USERNAME=Kurs91bot
TELEGRAM_MINIAPP_SHORT_NAME=tzmin
# Keep your current Vercel production URL here. Existing Vercel project may already have this variable.
NEXT_PUBLIC_APP_URL=https://your-current-project.vercel.app

# Supabase (SERVER SIDE ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Media authorization. Generate a long random secret (32+ bytes).
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
MEDIA_TOKEN_TTL_SECONDS=300
# Admin direct-upload / Course Package limit. Large media should be hosted in Stream/S3 providers and referenced by ID/URL.
COURSE_IMPORT_MAX_BYTES=4000000

# Legacy price fallbacks. Real prices are editable in Admin -> Courses / Settings.
ALL_ACCESS_SUBSCRIPTION_STARS=49
DEFAULT_COURSE_PRICE_STARS=99

# Optional S3-compatible provider example. Provider row uses secret_env_prefix=MEDIA_S3_MAIN.
MEDIA_S3_MAIN_ENDPOINT=
MEDIA_S3_MAIN_REGION=auto
MEDIA_S3_MAIN_BUCKET=
MEDIA_S3_MAIN_ACCESS_KEY_ID=
MEDIA_S3_MAIN_SECRET_ACCESS_KEY=

# Optional Bunny/Cloudflare values are configured only if you activate those providers.
MEDIA_BUNNY_STREAM_LIBRARY_ID=

# Optional external Office -> PDF converter webhook (future/optional adapter; PDFs work natively now).
DOCUMENT_CONVERTER_URL=
DOCUMENT_CONVERTER_TOKEN=

# Local preview only. Keep false in production.
ENABLE_DEMO_AUTH=false
DEMO_TELEGRAM_ID=653398188
DEMO_FIRST_NAME=Owner
DEMO_LANGUAGE_CODE=uk
DEMO_START_PARAM=space-pkk
