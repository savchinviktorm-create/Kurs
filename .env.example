# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Supabase (server-side only; NEVER expose SERVICE_ROLE in NEXT_PUBLIC_ variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Product settings
ALL_ACCESS_SUBSCRIPTION_STARS=49
DEFAULT_COURSE_PRICE_STARS=99

# Optional local preview outside Telegram. Keep false in production.
ENABLE_DEMO_AUTH=false
DEMO_TELEGRAM_ID=999001
DEMO_FIRST_NAME=Demo
